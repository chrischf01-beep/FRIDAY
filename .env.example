# Gemini API key used by the server-side @google/genai client.
# Create an API key in Google AI Studio and store it locally in .env (never commit .env).
# The value must be a Gemini API key (typically starts with `AIza`), not an OAuth access token,
# login cookie, or a value beginning with `AQ.`.
GEMINI_API_KEY=

# Optional: URL where the app is hosted.
APP_URL=
